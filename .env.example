# Copier en `.env` à la racine (lu par docker compose) et en `apps/api/.env` (lu par l'API).
# Aucune valeur secrète ici : identifiants de développement local uniquement.

# --- docker compose ---------------------------------------------------------
# Ports publiés sur 127.0.0.1 par les deux PostgreSQL de dev.
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# --- apps/api ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Base de dev (docker compose, service `postgres`).
DATABASE_URL=postgres://siteperso:siteperso@localhost:5432/siteperso
# Origine(s) du front autorisée(s) par CORS, séparées par des virgules.
CORS_ORIGIN=http://localhost:3001
# Rate limiting global par IP : RATE_LIMIT_MAX requêtes par fenêtre de RATE_LIMIT_WINDOW_MS ms
# (défaut 100 requêtes par minute). Au-delà : 429 application/problem+json.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# `true` uniquement derrière un reverse proxy de confiance (Caddy en prod) : l'IP du client est
# alors lue dans X-Forwarded-For pour que le rate limiting ne compte pas l'IP du proxy.
TRUST_PROXY=false

# Les tests e2e utilisent par défaut la base de test (service `postgres-test`) :
# DATABASE_URL=postgres://siteperso:siteperso@localhost:5433/siteperso_test
