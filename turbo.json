{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DATABASE_URL", "PORT", "HOST", "CORS_ORIGIN", "NODE_ENV"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DATABASE_URL", "PORT", "HOST", "CORS_ORIGIN", "NODE_ENV"],
      "outputs": ["coverage/**"]
    },
    "test:mutation": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@siteperso/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "env": ["NUXT_PUBLIC_*"]
    },
    "@siteperso/web#test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["NUXT_PUBLIC_*", "PLAYWRIGHT_PORT", "WEB_E2E_PORT", "CI"]
    }
  }
}
