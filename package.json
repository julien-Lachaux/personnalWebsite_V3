{
  "name": "siteperso-v3",
  "version": "0.0.0",
  "private": true,
  "description": "Site perso V3 : monorepo (API NestJS/Fastify, front Nuxt statique, contrats Zod/OpenAPI, SQL)",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=10.34.5"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "test:mutation": "turbo run test:mutation --concurrency=1",
    "hooks:test": "node --test \".claude/hooks/tests/*.test.mjs\"",
    "husky:test": "node --test \".husky/tests/*.test.mjs\"",
    "integrity": "bash scripts/ci/check-tests-integrity.sh",
    "release:next": "node scripts/ci/release.mjs next",
    "release:prepare": "node scripts/ci/release.mjs prepare",
    "integrity:test": "for t in scripts/ci/tests/*.test.sh; do bash \"$t\" || exit 1; done",
    "check": "pnpm hooks:test && pnpm husky:test && pnpm integrity:test && pnpm integrity && pnpm format:check && pnpm lint:workflows && pnpm lint:shell && pnpm db:test:up && pnpm e2e:browsers:up && turbo run lint typecheck test:coverage @siteperso/web#test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:workflows": "bash scripts/ci/static-analysis.sh workflows",
    "lint:shell": "bash scripts/ci/static-analysis.sh shell",
    "format:staged": "node .husky/check-staged-format.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:test:up": "docker compose up -d --wait postgres-test",
    "e2e:browsers:up": "docker compose up -d --wait playwright",
    "db:migrate": "pnpm --filter @siteperso/api db:migrate",
    "db:seed": "pnpm --filter @siteperso/api db:seed",
    "db:reset": "pnpm --filter @siteperso/api db:reset",
    "db:deleted:list": "pnpm --filter @siteperso/api db:deleted:list",
    "db:deleted:purge": "pnpm --filter @siteperso/api db:deleted:purge",
    "db:down": "docker compose down",
    "stack:up": "bash scripts/deploy/local-stack.sh up",
    "stack:logs": "bash scripts/deploy/local-stack.sh logs",
    "stack:ps": "bash scripts/deploy/local-stack.sh ps",
    "stack:down": "bash scripts/deploy/local-stack.sh down",
    "dev": "turbo run build --filter=@siteperso/contracts && pnpm --filter @siteperso/api dev",
    "dev:web": "turbo run build --filter=@siteperso/contracts && pnpm --filter @siteperso/web dev",
    "start": "pnpm --filter @siteperso/api start",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
