{
  "name": "siteperso-v3",
  "version": "0.0.0",
  "private": true,
  "description": "Site perso V3 : monorepo back-end (API NestJS/Fastify, contrats Zod/OpenAPI, SQL)",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=10.34.5"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "test:mutation": "turbo run test:mutation --concurrency=1",
    "hooks:test": "node --test \".claude/hooks/tests/*.test.mjs\"",
    "integrity": "bash scripts/ci/check-tests-integrity.sh",
    "integrity:test": "bash scripts/ci/tests/check-tests-integrity.test.sh",
    "check": "pnpm hooks:test && pnpm integrity:test && pnpm integrity && pnpm db:test:up && turbo run lint typecheck test test:e2e && turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:test:up": "docker compose up -d --wait postgres-test",
    "db:migrate": "pnpm --filter @siteperso/api db:migrate",
    "db:seed": "pnpm --filter @siteperso/api db:seed",
    "db:reset": "pnpm --filter @siteperso/api db:reset",
    "db:deleted:list": "pnpm --filter @siteperso/api db:deleted:list",
    "db:deleted:purge": "pnpm --filter @siteperso/api db:deleted:purge",
    "db:down": "docker compose down",
    "dev": "turbo run build --filter=@siteperso/contracts && pnpm --filter @siteperso/api dev",
    "start": "pnpm --filter @siteperso/api start",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "turbo": "2.11.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
