{
  "name": "siteperso-v3",
  "version": "0.0.0",
  "private": true,
  "description": "Site perso V3 : monorepo back-end (API NestJS/Fastify, contrats Zod/OpenAPI, SQL)",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.11.0 <23",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check": "pnpm db:test:up && turbo run lint typecheck test test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:test:up": "docker compose up -d --wait postgres-test",
    "db:down": "docker compose down",
    "dev": "pnpm --filter @siteperso/api dev",
    "start": "pnpm --filter @siteperso/api start",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "turbo": "2.11.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
