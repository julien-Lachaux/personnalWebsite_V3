# Modèle des variables de production. Copier en docker/.env.prod (ignoré par git) et remplir.
# Ne jamais commiter de vraie valeur : les mots de passe se génèrent avec `openssl rand -hex 24`.

# Nom de domaine servi par Caddy (DNS A/AAAA vers le VPS, ports 80 et 443 ouverts).
SITE_DOMAIN=example.test
# Mot de passe de l'utilisateur PostgreSQL `siteperso` (base privée, jamais publiée).
POSTGRES_PASSWORD=change-me
# Origine(s) du front autorisée(s) par CORS, séparées par des virgules.
CORS_ORIGIN=https://example.test
# Rate limiting global par IP : RATE_LIMIT_MAX requêtes par fenêtre de RATE_LIMIT_WINDOW_MS ms.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Ports hôte publiés par Caddy (défaut 80/443 ; à changer seulement pour un essai local).
# HTTP_PORT=80
# HTTPS_PORT=443
