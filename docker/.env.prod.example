# Modèle des variables de production. Copier en docker/.env.prod (ignoré par git) et remplir.
# Ne jamais commiter de vraie valeur : les mots de passe se génèrent avec `openssl rand -hex 24`.

# Nom de domaine servi par Caddy (DNS A/AAAA vers le VPS, ports 80 et 443 ouverts).
SITE_DOMAIN=example.test
# Mot de passe de l'utilisateur PostgreSQL `siteperso` (propriétaire : migrations, seeds, sauvegardes ; base privée, jamais publiée).
POSTGRES_PASSWORD=change-me
# Mot de passe du rôle PostgreSQL `siteperso_api` (select seul), utilisé par l'API. Créé par le service
# `migrate` à chaque déploiement. Hexadécimal de préférence (`openssl rand -hex 24`).
API_DB_PASSWORD=change-me
# Origine(s) du front autorisée(s) par CORS, séparées par des virgules.
CORS_ORIGIN=https://example.test
# Adresse du bouton « Lancer l'entretien » (lien mailto:), figée dans les pages à la génération du
# front : la vraie adresse se renseigne ici, sur le serveur, jamais dans le dépôt. Vide ou invalide,
# la génération échoue (le site précédent reste servi).
WEB_CONTACT_EMAIL=contact@example.org
# URL publique du site (canonical, hreflang), sans barre finale. Facultatif : https://SITE_DOMAIN par défaut.
# PUBLIC_SITE_URL=https://example.test
# Rate limiting global par IP : RATE_LIMIT_MAX requêtes par fenêtre de RATE_LIMIT_WINDOW_MS ms.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Ports hôte publiés par Caddy (défaut 80/443 ; à changer seulement pour un essai local).
# HTTP_PORT=80
# HTTPS_PORT=443

# Variante VPS sous Podman sans privilèges (docs/deploiement.md, « Production sous Podman »). Ces variables se
# posent dans l'environnement du compte de l'appli (pas dans ce fichier) : DEPLOY_COMPOSE=docker-compose,
# DEPLOY_INSPECT="podman inspect", DEPLOY_VARIANT=vps, DEPLOY_WEB_BUILD=podman, DEPLOY_DIR=<dossier de l'appli>.
# Dossier du socket partagé avec le Caddy de l'hôte (défaut /run/prod/site-perso) :
# PROD_RUN_DIR=/run/prod/site-perso
