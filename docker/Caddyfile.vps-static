# Variante VPS STATIQUE (lot 33) de docker/Caddyfile.vps : mêmes en-têtes, CSP, /fr, mode travaux et pages d'erreur ;
# seul le préfixe /api/* change (410 sans amont, aucun service api dans docker/compose.vps-static.yml). Écart borné
# par apps/api/test/prod-static.e2e-spec.ts.
# Variante VPS (Podman sans privilèges) : le Caddy de l'HÔTE tient 80/443, le TLS et la redirection
# HTTP vers HTTPS, puis relaie vers le socket Unix de ce Caddy (`reverse_proxy unix//run/prod/site-perso/web.sock`).
# Cette pile ne publie aucun port et ne fait aucun TLS.
# À lire avec cet écart : le corps qui suit (commentaires compris) est comparé octet pour octet à celui de
# docker/Caddyfile.vps, hors bloc /api/*. Ses commentaires décrivent donc la pile avec API : ici, le lien
# `current` est basculé par scripts/deploy/deploy-static.sh (et non web-generate.sh), Caddy est rechargé par
# ce même script, et aucun 502 « API arrêtée » ne peut survenir (plus d'amont).
{
	# Sans cette option, les X-Forwarded-* du frontal seraient écrasés et l'API verrait un seul client.
	# `trusted_proxies_unix` : tout pair du socket Unix est le Caddy de l'hôte (Caddy 2.11 ou plus).
	servers {
		trusted_proxies_unix
	}
	auto_https off
}

# Mode travaux : extraits (wip-on, wip-off…) importés dans le bloc du site (docker/wip.caddy).
import /etc/caddy/wip.caddy

# Adresse sans nom d'hôte : le frontal a déjà choisi le site ; le socket est le seul accès (0660).
http:// {
	bind unix//run/prod/web.sock|0660
	encode gzip zstd

	# Journal d'accès (JSON, sortie standard) : sert à vérifier l'IP réelle des clients, surtout IPv6
	# (voir docs/deploiement.md, « IP des clients et rate limiting »). Contient des adresses IP :
	# rotation et durée de conservation limitées (compose.prod.yml, `logging`).
	# La clé du mode travaux (`?acces=`, docker/wip.caddy) n'est jamais journalisée : le paramètre est retiré
	# de l'URI de chaque entrée.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete acces
				}
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Mode travaux (WIP_MODE, docker/wip.caddy) : sans effet tant que WIP_MODE vaut off.
	import wip-{$WIP_MODE:off}

	# Plus d'API en production (lot 33, décision du 25 nov. 2026) : le site est entièrement statique et l'API ne
	# sert qu'à le générer. Le préfixe `/api/*` répond donc 410 (Gone) en problem+json, quelle que soit la
	# méthode : la ressource a existé et a été retirée volontairement (un 404 laisserait croire à une adresse
	# mal écrite ; un 405 à une méthode à changer). Aucun amont, aucun corps lu.
	handle /api/* {
		header {
			Content-Type "application/problem+json"
			Cache-Control "no-cache"
			Content-Security-Policy "default-src 'none';frame-ancestors 'none'"
			X-Frame-Options "DENY"
			-Via
		}
		respond `{"type":"about:blank","title":"Gone","status":410,"detail":"L'API n'est plus exposée : le site est statique."}` 410
	}

	# Front statique (BF-14) : /srv/web/current est le lien du volume du site, basculé atomiquement par
	# web-generate.sh vers releases/<id>/ qui contient public/ (pages, _nuxt/, fonts/, cv/) et csp.caddy
	# (CSP et empreintes de cette génération, relevées par csp-hashes.mjs). Le rechargement de Caddy
	# (site.sh) relit csp.caddy après chaque publication. L'importation par motif n'échoue pas si aucune
	# version n'est encore publiée (première installation) : le site répond alors 404 sans CSP.

	# D15 : la langue par défaut n'a pas de préfixe ; `/fr` et `/fr/*` redirigent (301) vers le même
	# chemin sans préfixe (doublure de la page `meta refresh` que Nuxt génère, en 200). Une suite
	# mal formée (`/fr//hote`, `/fr/%09/hote`…) donnerait `//hote` après nettoyage par le navigateur : une
	# redirection hors du site, refusée par la liste blanche ci-dessous (404).
	#
	# Le matcher `path` nettoie le chemin (docs Caddy : « multiple slashes are merged ») : `/fr//hote`
	# y devient `/fr/hote` et la garde ci-dessous ne le voit plus (constaté : 301 au lieu de 404).
	# Le chemin d'origine, non nettoyé, est lu par `vars_regexp` sur `{http.request.orig_uri.path}` :
	# `/fr/` suivi de `/` ou `\` donne une erreur 404 (page 404 du front) avant la redirection.
	# Liste blanche : seul un chemin d'origine `/fr/` suivi d'un premier caractère de [A-Za-z0-9._~-] puis
	# d'aucun caractère de contrôle, espace, `\` ni `//` est redirigé ; tout autre chemin sous `/fr/` donne
	# une 404. Le chemin d'origine est lu décodé : `%09`, `%0d`, `%0a`, `%20`, `%2F`, `%5C` sont refusés
	# comme leurs caractères, `%252F` (devenu `%2F`) parce que `%` n'est pas dans la liste.
	@frbad {
		vars_regexp frbad {http.request.orig_uri.path} ^/fr/
		not vars_regexp frok {http.request.orig_uri.path} ^/fr/(?:[A-Za-z0-9._~-][^\x00-\x20\x7f\\]*)?$
	}
	handle @frbad {
		error 404
	}
	@frdbl vars_regexp frdbl {http.request.orig_uri.path} ^/fr/.*//
	handle @frdbl {
		error 404
	}

	@fr path_regexp fr ^/fr(?:/([A-Za-z0-9._~-][^\x00-\x20\x7f\\]*)?)?$
	handle @fr {
		redir * /{re.fr.1} permanent
	}

	handle {
		import /srv/web/current/csp.*
		header X-Frame-Options "DENY"
		# Fichiers à empreinte de Nuxt : le nom change avec le contenu, jamais de revalidation. Polices
		# (noms de version fixes, jamais modifiées sur place) : une semaine. Pages et PDF : revalidation
		# (ETag) à chaque visite, la nouvelle version est servie dès sa publication.
		@immutable path /_nuxt/*
		@fonts path /fonts/*
		@revalidate not path /_nuxt/* /fonts/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @fonts Cache-Control "public, max-age=604800"
		header @revalidate Cache-Control "no-cache"

		root * /srv/web/current/public
		# `/en` sert en/index.html sans redirection vers `/en/`.
		try_files {path} {path}/index.html
		file_server
	}

	# Erreurs produites par Caddy (413 du plafond de corps, 502 si l'API est arrêtée…) : sans `Server`.
	# Une route inconnue du front (404 du file_server) sert la vraie page 404 du front, avec son statut.
	# Une erreur serveur (500, 502, 503, 504) sert la page autonome 50x du front (lot 30) : par réécriture
	# (jamais de redirection : « Réessayer » recharge l'adresse affichée), avec le statut de l'erreur, la CSP
	# du front et `no-cache`. Sous /api/*, rien ne change : réponse texte brute de la dernière branche
	# (réponse HTML ou JSON de l'API en erreur : ticket séparé).
	handle_errors {
		header -Server
		header X-Frame-Options "DENY"
		# Pages d'erreur du front (404 partout, 50x hors /api/*) : CSP du front importée une seule fois.
		@fronterr expression {err.status_code} == 404 || (!path('/api/*') && {err.status_code} in [500, 502, 503, 504])
		handle @fronterr {
			import /srv/web/current/csp.*
			header Cache-Control "no-cache"
			root * /srv/web/current/public
			@front404 expression {err.status_code} == 404
			handle @front404 {
				# Pages 404 prérendues : en anglais sous /en, en français ailleurs.
				# La réécriture française d'abord, puis l'anglaise, décidée sur le chemin d'origine (le chemin
				# courant est déjà réécrit).
				@en404 vars_regexp en404 {http.request.orig_uri.path} ^/en(?:/|$)
				rewrite * /404.html
				rewrite @en404 /en/404.html
				file_server {
					status 404
				}
			}
			handle {
				@en50x vars_regexp en50x {http.request.orig_uri.path} ^/en(?:/|$)
				rewrite * /50x.html
				rewrite @en50x /en/50x.html
				file_server {
					status {err.status_code}
				}
			}
		}
		handle {
			respond "{err.status_code} {err.status_text}" {err.status_code}
		}
	}
}
