# Pile locale complète (pnpm stack:up) : mêmes compose.prod.yml, Caddyfile et image que la production.
# `pnpm stack:up` crée docker/.env.local (ignoré par git) depuis ce modèle et y génère les mots de passe.
# Ne jamais commiter docker/.env.local.

# Nom de projet compose distinct de la production (conteneurs, réseaux et volumes séparés).
COMPOSE_PROJECT_NAME=siteperso-v3-local
# Domaine servi par Caddy : `localhost` donne un certificat interne (autorité propre à Caddy).
SITE_DOMAIN=localhost
# Ports hôte (la production publie 80 et 443). HTTPS_PORT alimente aussi la redirection HTTP vers HTTPS.
HTTP_PORT=8080
HTTPS_PORT=8443
# Doit reprendre le port HTTPS ci-dessus.
CORS_ORIGIN=https://localhost:8443
# Mots de passe PostgreSQL : valeurs générées par scripts/deploy/local-stack.sh (openssl rand -hex 24).
POSTGRES_PASSWORD=__GENERE__
API_DB_PASSWORD=__GENERE__
# Mêmes valeurs qu'en production (docker/.env.prod.example).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
