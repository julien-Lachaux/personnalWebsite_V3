# Copier en `apps/web/.env` (jamais commité). Valeurs lues par `nuxt dev` et par `nuxt generate`, qui
# les fige dans les pages : rien de secret ici, et aucune vraie adresse dans le dépôt.

# Source du contenu (privée, absente des pages) : `api` (défaut : `GET /api/v1/cv?lang=` au build) ou
# `fixtures` (fixtures du dépôt, validées par les contrats : développement sans API, parcours
# Playwright). Avec `api`, une API injoignable fait échouer la génération : jamais de repli.
NUXT_CV_SOURCE=api

# URL de base de l'API, sans `/api/v1` (privée). Obligatoire avec NUXT_CV_SOURCE=api.
NUXT_API_BASE_URL=http://localhost:3000

# Adresse du bouton « Lancer l'entretien » (lien mailto:, lot F3). Placeholder uniquement. Vide ou
# invalide, la génération statique échoue.
NUXT_PUBLIC_CONTACT_EMAIL=contact@example.org

# URL publique du site : préfixe absolu des liens hreflang et canonical (défaut http://localhost:3001).
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3001
