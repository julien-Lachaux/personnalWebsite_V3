# Copier en `apps/web/.env` (jamais commité). Valeurs publiques lues par `nuxt dev` et figées dans les
# pages par `nuxt generate` : rien de secret ici, et aucune vraie adresse dans le dépôt.

# Adresse du bouton « Lancer l'entretien » (lien mailto:, lot F3). Placeholder uniquement.
NUXT_PUBLIC_CONTACT_EMAIL=contact@example.org

# URL publique du site : préfixe absolu des liens hreflang et canonical (défaut http://localhost:3001).
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3001
